{
  "name": "@tracing/cli",
  "version": "0.1.1",
  "description": "Official command-line client for Tracing: sign in, list and update tasks, and script your boards from the terminal",
  "license": "MIT",
  "author": "Go Figure (https://github.com/Go-Figure-App)",
  "homepage": "https://github.com/Go-Figure-App/tracing/tree/main/packages/cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/Go-Figure-App/tracing/",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "tracing": "dist/tracing.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cli",
    "kanban",
    "tracing",
    "project-management",
    "tasks",
    "terminal"
  ],
  "scripts": {
    "build": "vp run compile",
    "prepublishOnly": "pnpm run build",
    "dev": "tsx src/bin.ts",
    "lint": "vp check .",
    "test": "vp run test:run",
    "test:watch": "vp test --config vitest.config.ts",
    "typecheck": "vp run check:types"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.6",
    "@gabrielbryk/jq-ts": "1.7.0",
    "@tracing/mcp": "workspace:*",
    "@tracing/typescript-config": "workspace:*",
    "@types/node": "^26.6.5",
    "effect": "4.0.6",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "private": true
}
